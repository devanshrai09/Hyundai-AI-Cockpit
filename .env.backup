# Copy to .env (never commit .env)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini        # set to any model your account can use
# OPENAI_TIMEOUT=20
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b        # offline / fallback model
UI_PORT=8765
# Optional real integrations (use an app password, not your main password)
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
